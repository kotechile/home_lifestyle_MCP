# Home, Real Estate & Lifestyle Intelligence MCP Environment Configuration

# Choose your LLM provider: "openrouter", "openai", "gemini", or "mock"
LLM_PROVIDER=openrouter

# OpenRouter (Recommended for Hermes 3: nousresearch/hermes-3-llama-3.1-405b or 8b)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI (if using gpt-4o-mini or gpt-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini (if using Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Database path override (optional)
# DB_PATH=data/home_intelligence.db

# MCP Server Settings
MCP_TRANSPORT=stdio
MCP_PORT=8081
MCP_HOST=0.0.0.0
