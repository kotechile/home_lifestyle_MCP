{
  "name": "Home & Lifestyle - Daily Slack Briefing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "1",
      "name": "Daily at 8:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://72.61.72.70/api/insights/recent?days_back=1&limit=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Host",
              "value": "lifestyle.giniloh.com"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "2",
      "name": "Fetch Recent Lifestyle Intelligence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"text\": \"🏡 *Daily Home & Lifestyle Intelligence Briefing* ({{ $json.count }} new items)\\n\\n{{ $json.items.map(i => `• *[${i.source_name}]* ${i.title}\\n  ${i.summary}\\n  👉 <${i.url}|Read full article>`).join('\\n\\n') }}\"\n}",
        "options": {}
      },
      "id": "3",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Daily at 8:00 AM": {
      "main": [
        [
          {
            "node": "Fetch Recent Lifestyle Intelligence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Recent Lifestyle Intelligence": {
      "main": [
        [
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
